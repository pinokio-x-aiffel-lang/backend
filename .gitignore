# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# === Mac only ===
.DS_Store

# === Jupyter / notebooks ===
.ipynb_checkpoints/
*.ipynb_checkpoints

# === logs ===
logs/
*.log
*.out
*.err

# === env ===
.env
# 배포용 시크릿(.env.docker.example 만 커밋)
.env.docker

# === MCP (contains API keys in plaintext) ===
.mcp.json

# === Claude Code local settings (machine-specific) ===
.claude/settings.local.json

# === kosis generated artifacts ===
kosis/result_ztitle.csv
kosis/ztitle_full.ckpt

# === kosis/innnn/ async crawl outputs (regenerable, too large for git) ===
kosis/innnn/*.csv
kosis/innnn/*.json
kosis/innnn/*.jsonl
kosis/innnn/*.checkpoint

kosis/aain/*.csv
kosis/aain/*.jsonl
kosis/aain/*.idx
kosis/aain/*.backup

# === large processed data (regenerable, >50 MB) ===
data/processed/*.csv
data/processed/*.parquet

# === Excel temp files ===
~$*.xlsx
~$*.xls
~$*.xlsm
