KOSIS_API_KEY=
DART_API_KEY=

# --- Admin 로그인 (단일 계정) ---
# 이 ID/비밀번호와 일치하는 사람만 로그인 통과. 비밀번호는 bcrypt 해시로 저장(평문 금지).
# 해시 생성: uv run python -c "from src.auth.password import hash_password; print(hash_password('비번'))"
# 주의: config.Settings 는 .env 를 자동 로드하지 않으므로 로컬 실행 시 아래 값을 export 해야 적용됨.
ADMIN_ID=admin
ADMIN_PASSWORD_HASH=
ADMIN_NAME=admin
