# docker compose 배포용 환경변수 예시.
#   cp .env.docker.example .env.docker  → 값 채우기 → docker compose --env-file .env.docker up -d --build
# 주의: .env.docker 는 시크릿을 담으므로 커밋하지 말 것(.gitignore 에 등록됨).

# --- Infisical (LLM/HCX 시크릿 주입) ---
# 배포 프로젝트+환경에 스코프된 서비스 토큰 또는 머신 아이덴티티 토큰.
# 비워두면 앱이 Infisical 없이 기동된다(시크릿 미주입).
INFISICAL_TOKEN=

# --- KOSIS ---
KOSIS_API_KEY=

# --- pgvector (PostgreSQL) ---
POSTGRES_USER=fnd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fnd
# 호스트 노출 포트(컨테이너 내부는 항상 5432). 5432 는 langfuse 가 점유하므로 5433 사용.
DB_HOST_PORT=5433
# 앱(컨테이너)→DB(컨테이너) 연결 DSN. 호스트명은 compose 서비스명 'db', 포트 5432.
DATABASE_URL=postgresql://fnd:change-me@db:5432/fnd

# --- App ---
APP_HOST_PORT=8000
# 프론트(브라우저) origin — CORS 허용 목록(쉼표 구분).
FRONTEND_ORIGINS=https://pinokiox-frontend.onrender.com

# --- Admin 로그인 (단일 계정) ---
# 이 ID/비밀번호와 일치하는 사람만 로그인 통과. 비밀번호는 평문이 아닌 bcrypt 해시로 저장.
# 해시 생성:
#   uv run python -c "from src.auth.password import hash_password; print(hash_password('원하는비밀번호'))"
# 주의: docker compose 변수 보간 때문에 해시의 '$' 는 반드시 '$$' 로 이스케이프할 것.
#   예) $2b$12$abc...  →  $$2b$$12$$abc...
JWT_SECRET_KEY=change-me-in-production
ADMIN_ID=admin
ADMIN_PASSWORD_HASH=
ADMIN_NAME=admin
